---
import "../styles/global.css";

const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const assetPath = (path) => `${basePath}${path.replace(/^\//, "")}`;

const installCommands = [
  "npm install -g @matheusbbarni/atelier",
  "atelier --doctor",
  "atelier",
];

const heroCommands = [
  ["npm install -g", "@matheusbbarni/atelier"],
  ["atelier --doctor"],
  ["atelier"],
];

const featureGroups = [
  {
    title: "Run Orchestration",
    kicker: "One prompt stays one run.",
    items: [
      "Orchestrator-owned run plans",
      "Explorer, Oracle, Fixer, Reviewer, Consul, Librarian, and Designer profiles",
      "Clarifying questions when scope is not safe enough",
      "Serial council for high-risk architecture, security, and review calls",
      "Parallel step groups for disjoint file scopes",
      "Run, step, command, and review-fix limits",
    ],
  },
  {
    title: "Terminal Interface",
    kicker: "A working TUI, not a detached log.",
    items: [
      "Chat for routing decisions, actions, diffs, diagnostics, and final results",
      "Agent Roster with model, runtime, availability, and active step",
      "Input Composer for prompts, answers, and interrupts",
      "Live runtime stream snippets while an agent is working",
      "Follow mode that respects manual scrolling",
      "Slash commands for goals, config, subtasks, agents, and skills",
    ],
  },
  {
    title: "Runtime Choices",
    kicker: "Use the CLIs and credentials you already have.",
    items: [
      "Codex CLI runtime with Codex-owned login",
      "Claude CLI runtime with Claude-owned login",
      "Cursor Agent CLI runtime with Cursor-owned login",
      "Z.ai HTTP runtime through an environment credential reference",
      "Fake runtime for deterministic tests",
      "Per-agent model assignments and fallback chains",
    ],
  },
  {
    title: "Control Plane",
    kicker: "The harness owns the actions.",
    items: [
      "Capability enforcement for read, edit, command, verify, and review work",
      "Action approval for high-impact operations",
      "Tool allowlists for narrower agent profiles",
      "Credential references instead of secrets in config",
      "Redacted TOML output from print-config",
      "VCS actions only when explicitly requested",
    ],
  },
  {
    title: "Project Memory",
    kicker: "Every run leaves useful evidence behind.",
    items: [
      "Session events under .multiagent/sessions",
      "Artifacts for large output, diffs, and run material",
      "Run records under .multiagent/runs",
      "Context resume from harness-owned history",
      "Clean-session command for local history cleanup",
      "Codemap state for repository orientation",
    ],
  },
  {
    title: "Distribution",
    kicker: "Install once, run where the work is.",
    items: [
      "Global npm package at @matheusbbarni/atelier",
      "Prebuilt native platform binary packages",
      "macOS, glibc Linux, and Windows arm64/x64 targets",
      "GitHub Release archives and checksum manifests",
      "Cargo install path for source builds",
      "atelier --update through the npm launcher",
    ],
  },
];

const cliCommands = [
  ["atelier", "Open the TUI in the current working directory."],
  ["atelier --cwd <path>", "Start from a selected working directory."],
  ["atelier --config <path>", "Use a specific harness configuration file."],
  ["atelier --doctor", "Check runtime setup before work starts."],
  ["atelier --doctor --json", "Emit doctor output for scripts and CI."],
  ["atelier --print-config", "Print the merged config with secrets redacted."],
  ["atelier --init-config", "Create starter config and instruction files."],
  ["atelier --codemap init", "Write folder-level codemap docs and state."],
  ["atelier --codemap changes", "Report stale codemaps without writing."],
  ["atelier --codemap update", "Regenerate stale codemaps and refresh state."],
  ["atelier --clean-sessions", "Delete project-local session history after confirmation."],
  ["atelier --clean-sessions --yes", "Clean project-local history without a prompt."],
  ["atelier --update", "Update the global npm install."],
  ["atelier --debug", "Launch with extra diagnostics."],
];

const tuiCommands = [
  ["/goal <text>", "Set the active session goal."],
  ["/goal", "Show the current goal."],
  ["/goal clear", "Clear the active goal."],
  ["/config", "Show active config files, preset, and warnings."],
  ["/subtask <agent> <task>", "Run a bounded child task through one enabled agent."],
  ["/agent:<name>", "Route a prompt to a selected agent profile."],
  ["/skill:<name>", "Prefix a prompt with a cached project or personal skill."],
  ["/reload:skills", "Refresh cached skill names."],
];

const workflowSteps = [
  ["01", "Prompt", "You type the work once. Atelier starts one run and records it."],
  ["02", "Route", "The Orchestrator chooses a single agent, a council, or a parallel group."],
  ["03", "Act", "Agents ask the harness for reads, edits, commands, approvals, and verification."],
  ["04", "Review", "Reviewer findings go back to the Orchestrator instead of editing directly."],
  ["05", "Record", "History, artifacts, diffs, diagnostics, and run results stay under .multiagent."],
];

const visualFrames = [
  {
    title: "Run Surface",
    text: "Agents, chat, and the prompt composer stay visible in one terminal workspace.",
    src: "/images/atelier-tui-run-surface.png",
    alt: "Atelier TUI with agent roster, empty chat pane, and prompt composer.",
  },
  {
    title: "Skill Picker",
    text: "/skill: opens cached project and personal skills without leaving the run.",
    src: "/images/atelier-tui-skill-picker.png",
    alt: "Atelier TUI showing the skill picker for project and personal skills.",
  },
  {
    title: "Agent Picker",
    text: "/agent: shows enabled agent profiles, runtimes, and capability sets before routing work.",
    src: "/images/atelier-tui-agent-picker.png",
    alt: "Atelier TUI showing the agent picker with runtimes and capability sets.",
  },
  {
    title: "Help Overlay",
    text: "/help keeps TUI and CLI commands available while the session stays underneath.",
    src: "/images/atelier-tui-help.png",
    alt: "Atelier TUI showing the help overlay with TUI and CLI commands.",
  },
];

const orchestratorAgent = {
  name: "The Orchestrator",
  role: "Supreme Executor & Delegator",
  src: "/images/agents/orchestrator.png",
  alt: "Orchestrator agent: a wizard conjuring a glowing magic circle to direct the run.",
};

const supportingAgents = [
  {
    name: "Explorer",
    role: "Codebase Recon",
    src: "/images/agents/explorer.png",
    alt: "Explorer agent: an adventurer surveying terrain through a spyglass.",
  },
  {
    name: "Librarian",
    role: "Knowledge Retrieval",
    src: "/images/agents/librarian.png",
    alt: "Librarian agent: a figure retrieving documents among towering archives.",
  },
  {
    name: "Designer",
    role: "Visual Excellence",
    src: "/images/agents/designer.png",
    alt: "Designer agent: a maker arranging interface panels and design surfaces.",
  },
  {
    name: "Reviewer",
    role: "Critical Review",
    src: "/images/agents/reviewer.png",
    alt: "Reviewer agent: an inspector scrutinizing layered evidence for regressions.",
  },
  {
    name: "Oracle",
    role: "Strategic Advisor",
    src: "/images/agents/oracle.png",
    alt: "Oracle agent: a robed seer reading a glowing tome of runes.",
  },
  {
    name: "Consul",
    role: "Planning & Reflection",
    src: "/images/agents/consul.png",
    alt: "Consul agent: a counselor weighing orbiting plans in a vaulted hall.",
  },
  {
    name: "Fixer",
    role: "Implementation Specialist",
    src: "/images/agents/fixer.png",
    alt: "Fixer agent: an armored engineer applying precise, scoped changes.",
  },
];

const leftAgents = supportingAgents.slice(0, 4);
const rightAgents = supportingAgents.slice(4);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Atelier is a terminal-native agent orchestration harness for local repositories."
    />
    <title>Atelier - Terminal-native agent orchestration</title>
    <link rel="icon" href={assetPath("/favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={assetPath("/images/atelier-logo-256.png")} />
    <meta name="theme-color" content="#08131f" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,500;6..72,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main>
      <section class="hero" aria-labelledby="hero-title">
        <img
          class="hero__image"
          src={assetPath("/images/atelier-command-center.png")}
          alt="Dark terminal command center with agent panels, timelines, and diff-like surfaces."
        />
        <div class="hero__shade" aria-hidden="true"></div>
        <header class="nav" aria-label="Primary">
          <a class="brand" href="#top" aria-label="Atelier home">
            <img
              class="brand__mark"
              src={assetPath("/images/atelier-logo-256.png")}
              alt=""
              aria-hidden="true"
              width="36"
              height="36"
              loading="eager"
            />
            <span>Atelier</span>
          </a>
          <div class="nav__right">
            <nav class="nav__links">
              <a href="#features">Features</a>
              <a href="#commands">Commands</a>
              <a href="#install">Install</a>
            </nav>
            <a
              class="github-star"
              href="https://github.com/MatheusBBarni/atelier"
              target="_blank"
              rel="noreferrer"
              aria-label="Star Atelier on GitHub"
              data-github-star
            >
              <span class="github-star__github" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false">
                  <path
                    d="M12 1.8c-5.7 0-10.3 4.6-10.3 10.3 0 4.5 2.9 8.4 7 9.8.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.2-3.4-1.2-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.6 1.1 1.6 1.1.9 1.6 2.4 1.1 2.9.9.1-.7.4-1.1.7-1.4-2.3-.3-4.6-1.1-4.6-5 0-1.1.4-2 1.1-2.8-.1-.3-.5-1.3.1-2.8 0 0 .9-.3 2.8 1.1.8-.2 1.6-.3 2.5-.3s1.7.1 2.5.3c1.9-1.3 2.8-1.1 2.8-1.1.6 1.5.2 2.5.1 2.8.7.8 1.1 1.7 1.1 2.8 0 3.9-2.4 4.7-4.6 5 .4.3.7.9.7 1.8v2.7c0 .3.2.6.7.5 4.1-1.4 7-5.3 7-9.8 0-5.7-4.6-10.3-10.3-10.3z"
                  />
                </svg>
              </span>
              <span class="github-star__label">Star on GitHub</span>
              <span class="github-star__count" data-github-star-count hidden></span>
              <span class="github-star__star" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false">
                  <path
                    d="m12 2.5 2.9 5.9 6.5 1-4.7 4.5 1.1 6.4L12 17.2l-5.8 3.1 1.1-6.4-4.7-4.5 6.5-1L12 2.5z"
                  />
                </svg>
              </span>
            </a>
          </div>
        </header>

        <div class="hero__content" id="top">
          <img
            class="hero__logo"
            src={assetPath("/images/atelier-logo.png")}
            alt="Atelier app icon: a teal and cream wizard hat above a terminal prompt, framed in gold on deep navy."
            width="104"
            height="104"
            loading="eager"
          />
          <p class="eyebrow">Terminal-native agent orchestration</p>
          <h1 id="hero-title">Atelier</h1>
          <p class="hero__lede">
            Run one prompt in a local repo and let the harness route the work
            through the right agents. You keep the terminal, the history, the
            approvals, and the final call.
          </p>
          <div class="hero__actions" aria-label="Primary actions">
            <a class="button button--primary" href="#install">
              <span class="button__icon" aria-hidden="true">></span>
              Install
            </a>
            <a class="button button--ghost" href="#features">
              <span class="button__icon" aria-hidden="true">*</span>
              See Features
            </a>
          </div>
        </div>

        <aside class="hero__terminal" aria-label="Install command preview">
          {
            heroCommands.map((lines) => (
              <code>{lines.map((line) => <span>{line}</span>)}</code>
            ))
          }
        </aside>
      </section>

      <section class="quick-band" aria-label="Product summary">
        <div class="quick-band__inner">
          <p>
            Built for developers who already live in a terminal and want agents
            to work inside the repo boundary, not around it.
          </p>
          <dl>
            <div>
              <dt>5</dt>
              <dd>runtime paths</dd>
            </div>
            <div>
              <dt>8</dt>
              <dd>agent profiles</dd>
            </div>
            <div>
              <dt>1</dt>
              <dd>active run</dd>
            </div>
          </dl>
        </div>
      </section>

      <section class="section--agents" aria-labelledby="agents-title">
        <div class="agents__sky" aria-hidden="true"></div>
        <div class="agents__inner">
          <div class="section__heading section__heading--narrow">
            <p class="eyebrow">Agent Roster</p>
            <h2 id="agents-title">One run, the right specialists.</h2>
            <p>
              The Orchestrator owns the run and delegates to focused agents —
              recon, knowledge, design, review, advice, planning, and
              implementation — each with its own capabilities and runtime.
            </p>
          </div>

          <div class="constellation">
            <div class="constellation__column">
              {
                leftAgents.map((agent) => (
                  <article class="agent-card">
                    <figure>
                      <img src={assetPath(agent.src)} alt={agent.alt} loading="lazy" />
                    </figure>
                    <div class="agent-card__caption">
                      <h3>{agent.name}</h3>
                      <p>{agent.role}</p>
                    </div>
                  </article>
                ))
              }
            </div>

            <article class="agent-hero">
              <figure>
                <img
                  src={assetPath(orchestratorAgent.src)}
                  alt={orchestratorAgent.alt}
                  loading="lazy"
                />
              </figure>
              <div class="agent-hero__caption">
                <h3>{orchestratorAgent.name}</h3>
                <p>{orchestratorAgent.role}</p>
              </div>
            </article>

            <div class="constellation__column">
              {
                rightAgents.map((agent) => (
                  <article class="agent-card">
                    <figure>
                      <img src={assetPath(agent.src)} alt={agent.alt} loading="lazy" />
                    </figure>
                    <div class="agent-card__caption">
                      <h3>{agent.name}</h3>
                      <p>{agent.role}</p>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <section class="section section--split" aria-labelledby="why-title">
        <div class="section__copy">
          <p class="eyebrow">Why it exists</p>
          <h2 id="why-title">Agent work needs a control plane.</h2>
          <p>
            Atelier treats agent activity as a run with routing, scopes,
            results, and evidence. The runtime can think and stream. The
            harness owns file edits, shell commands, approvals, limits, and the
            durable record.
          </p>
        </div>

        <figure class="surface-map" aria-label="Atelier TUI run surface">
          <img
            src={assetPath("/images/atelier-tui-run-surface.png")}
            alt="Atelier TUI showing the agent roster, chat panel, and prompt composer."
            loading="lazy"
          />
        </figure>
      </section>

      <section class="section" id="features" aria-labelledby="features-title">
        <div class="section__heading">
          <p class="eyebrow">Feature Map</p>
          <h2 id="features-title">Everything Atelier is already shaped to do.</h2>
          <p>
            The site is pulling from the current README and project docs. That
            means the boring but important pieces are here too: config,
            distribution, history, limits, and tests.
          </p>
        </div>

        <div class="feature-grid">
          {
            featureGroups.map((group) => (
              <article class="feature-card">
                <div class="feature-card__cap">
                  <span aria-hidden="true"></span>
                  <p>{group.kicker}</p>
                </div>
                <h3>{group.title}</h3>
                <ul>
                  {group.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section section--workflow" aria-labelledby="workflow-title">
        <div class="section__heading section__heading--narrow">
          <p class="eyebrow">How a run moves</p>
          <h2 id="workflow-title">The loop is explicit.</h2>
          <p>
            No hidden handoff between agents. Each result comes back to the
            Orchestrator, and the next step is a decision the harness can show,
            persist, and bound.
          </p>
        </div>

        <ol class="workflow">
          {
            workflowSteps.map(([number, title, body]) => (
              <li>
                <span>{number}</span>
                <h3>{title}</h3>
                <p>{body}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="section section--split section--image" aria-labelledby="runtime-title">
        <figure class="product-visual">
          <img
            src={assetPath("/images/atelier-command-center.png")}
            alt="Layered dark interface showing parallel agent activity and review panes."
          />
        </figure>
        <div class="section__copy">
          <p class="eyebrow">Runtimes</p>
          <h2 id="runtime-title">Bring the agents you actually use.</h2>
          <p>
            Codex, Claude, and Cursor run through their local CLIs and login
            state. Z.ai uses an API-key environment reference. The fake runtime
            keeps tests deterministic. Atelier keeps those paths separate so
            config stays readable and credentials stay out of project files.
          </p>
        </div>
      </section>

      <section class="section section--visuals" aria-labelledby="visuals-title">
        <div class="section__heading">
          <p class="eyebrow">Product Views</p>
          <h2 id="visuals-title">Four views of the same control loop.</h2>
          <p>
            The UI is not trying to hide the work. These real TUI states show
            the run surface, pickers, and command reference inside the product.
          </p>
        </div>

        <div class="visual-grid">
          {
            visualFrames.map((frame) => (
              <article class="visual-card">
                <figure>
                  <img src={assetPath(frame.src)} alt={frame.alt} loading="lazy" />
                </figure>
                <div>
                  <h3>{frame.title}</h3>
                  <p>{frame.text}</p>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section" id="commands" aria-labelledby="commands-title">
        <div class="section__heading">
          <p class="eyebrow">Command Surface</p>
          <h2 id="commands-title">The flags are part of the product.</h2>
          <p>
            The CLI is intentionally small. You can open the TUI, inspect setup,
            print config, manage codemaps, clean history, and update the npm
            install without learning a second tool.
          </p>
        </div>

        <div class="command-layout">
          <article class="command-table" aria-labelledby="cli-title">
            <h3 id="cli-title">CLI</h3>
            <dl>
              {
                cliCommands.map(([command, description]) => (
                  <div>
                    <dt><code>{command}</code></dt>
                    <dd>{description}</dd>
                  </div>
                ))
              }
            </dl>
          </article>

          <article class="command-table" aria-labelledby="tui-title">
            <h3 id="tui-title">TUI</h3>
            <dl>
              {
                tuiCommands.map(([command, description]) => (
                  <div>
                    <dt><code>{command}</code></dt>
                    <dd>{description}</dd>
                  </div>
                ))
              }
            </dl>
          </article>
        </div>
      </section>

      <section class="install" id="install" aria-labelledby="install-title">
        <div>
          <p class="eyebrow">Install</p>
          <h2 id="install-title">Start with npm. Build from source when you need to.</h2>
          <p>
            The npm package installs a prebuilt native binary and leaves your
            home config alone. Run doctor first, then open Atelier in the repo
            you want agents to work on.
          </p>
        </div>
        <div class="install__panel">
          <pre><code>{installCommands.join("\n")}</code></pre>
          <p>
            Source build: <code>cargo install --path .</code>
          </p>
        </div>
      </section>
    </main>
    <script is:inline>
      (() => {
        const button = document.querySelector("[data-github-star]");
        const count = document.querySelector("[data-github-star-count]");
        if (!button || !count) {
          return;
        }

        const formatter = new Intl.NumberFormat("en-US", {
          maximumFractionDigits: 0,
        });

        fetch("https://api.github.com/repos/MatheusBBarni/atelier", {
          headers: {
            Accept: "application/vnd.github+json",
          },
        })
          .then((response) => {
            if (!response.ok) {
              throw new Error("GitHub star count unavailable");
            }
            return response.json();
          })
          .then((repo) => {
            if (typeof repo.stargazers_count !== "number") {
              throw new Error("GitHub star count missing");
            }
            count.textContent = formatter.format(repo.stargazers_count);
            count.hidden = false;
            button.setAttribute(
              "aria-label",
              `Star Atelier on GitHub, ${formatter.format(repo.stargazers_count)} stars`,
            );
          })
          .catch(() => {
            count.hidden = true;
          });
      })();
    </script>
  </body>
</html>
