{
  "name": "npm",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "workspaces": [
        "package",
        "platform/*"
      ],
      "engines": {
        "node": ">=20",
        "npm": ">=10"
      }
    },
    "node_modules/@matheusbbarni/atelier": {
      "resolved": "package",
      "link": true
    },
    "node_modules/@matheusbbarni/atelier-darwin-arm64": {
      "resolved": "platform/darwin-arm64",
      "link": true
    },
    "node_modules/@matheusbbarni/atelier-darwin-x64": {
      "resolved": "platform/darwin-x64",
      "link": true
    },
    "node_modules/@matheusbbarni/atelier-linux-arm64": {
      "resolved": "platform/linux-arm64",
      "link": true
    },
    "node_modules/@matheusbbarni/atelier-linux-x64": {
      "resolved": "platform/linux-x64",
      "link": true
    },
    "node_modules/@matheusbbarni/atelier-win32-arm64": {
      "resolved": "platform/win32-arm64",
      "link": true
    },
    "node_modules/@matheusbbarni/atelier-win32-x64": {
      "resolved": "platform/win32-x64",
      "link": true
    },
    "package": {
      "name": "@matheusbbarni/atelier",
      "version": "0.1.0",
      "license": "MIT",
      "bin": {
        "atelier": "bin/atelier.js"
      },
      "engines": {
        "node": ">=20"
      },
      "optionalDependencies": {
        "@matheusbbarni/atelier-darwin-arm64": "0.1.0",
        "@matheusbbarni/atelier-darwin-x64": "0.1.0",
        "@matheusbbarni/atelier-linux-arm64": "0.1.0",
        "@matheusbbarni/atelier-linux-x64": "0.1.0",
        "@matheusbbarni/atelier-win32-arm64": "0.1.0",
        "@matheusbbarni/atelier-win32-x64": "0.1.0"
      }
    },
    "platform/darwin-arm64": {
      "name": "@matheusbbarni/atelier-darwin-arm64",
      "version": "0.1.0",
      "cpu": [
        "arm64"
      ],
      "license": "MIT",
      "os": [
        "darwin"
      ]
    },
    "platform/darwin-x64": {
      "name": "@matheusbbarni/atelier-darwin-x64",
      "version": "0.1.0",
      "cpu": [
        "x64"
      ],
      "license": "MIT",
      "os": [
        "darwin"
      ]
    },
    "platform/linux-arm64": {
      "name": "@matheusbbarni/atelier-linux-arm64",
      "version": "0.1.0",
      "cpu": [
        "arm64"
      ],
      "libc": [
        "glibc"
      ],
      "license": "MIT",
      "os": [
        "linux"
      ]
    },
    "platform/linux-x64": {
      "name": "@matheusbbarni/atelier-linux-x64",
      "version": "0.1.0",
      "cpu": [
        "x64"
      ],
      "libc": [
        "glibc"
      ],
      "license": "MIT",
      "os": [
        "linux"
      ]
    },
    "platform/win32-arm64": {
      "name": "@matheusbbarni/atelier-win32-arm64",
      "version": "0.1.0",
      "cpu": [
        "arm64"
      ],
      "license": "MIT",
      "os": [
        "win32"
      ]
    },
    "platform/win32-x64": {
      "name": "@matheusbbarni/atelier-win32-x64",
      "version": "0.1.0",
      "cpu": [
        "x64"
      ],
      "license": "MIT",
      "os": [
        "win32"
      ]
    }
  }
}
